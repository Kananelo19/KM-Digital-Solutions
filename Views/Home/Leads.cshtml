@model IReadOnlyList<KM_Digital_Solutions.Models.LeadViewModel>

@{
    ViewData["Title"] = "Project Leads";
}

<section class="page-hero page-hero-compact">
    <div class="container">
        <span class="eyebrow">KM Digital Dashboard</span>
        <h1>Project leads</h1>
        <p>
            Review project requests submitted through the KM Digital Solutions contact form.
            These leads are stored while the app is running.
        </p>
    </div>
</section>

<section class="content-section">
    <div class="container">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <h2>No leads yet</h2>
                <p>Submit the contact form once, then refresh this page to see the request here.</p>
                <a class="btn btn-success"
                   asp-controller="Home"
                   asp-action="Contact">
                    Test Contact Form
                </a>
            </div>
        }
        else
        {
            <div class="leads-header">
                <div>
                    <h2>@Model.Count Project Lead@(Model.Count == 1 ? "" : "s")</h2>
                    <p>Newest requests appear first.</p>
                </div>

                <a class="btn btn-success"
                   asp-controller="Home"
                   asp-action="Contact">
                    Add Test Lead
                </a>
            </div>

            <div class="table-responsive leads-table-wrap">
                <table class="table leads-table align-middle">
                    <thead>
                        <tr>
                            <th>Submitted</th>
                            <th>Name</th>
                            <th>Business</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Project</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lead in Model)
                        {
                            <tr>
                                <td>@lead.SubmittedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td>@lead.Name</td>
                                <td>@lead.BusinessName</td>
                                <td>@lead.Phone</td>
                                <td>
                                    <a href="mailto:@lead.Email">@lead.Email</a>
                                </td>
                                <td>@lead.ProjectType</td>
                                <td>@lead.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
