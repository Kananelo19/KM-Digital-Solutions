@{
    ViewData["Title"] = "About";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">About KM Digital Solutions</span>
        <h1>Practical websites and systems for local businesses.</h1>
        <p>
            KM Digital Solutions helps service businesses get online with a site that looks
            professional, explains the offer clearly, and makes it easy for customers to call,
            book, or request a quote.
        </p>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <h2>Built by a software engineer who understands business workflow.</h2>
                <p>
                    KM Digital Solutions is led by Kananelo Motaung, a software engineer focused
                    on building reliable applications, database-driven systems, and structured
                    business workflows using .NET, SQL, and modern web technologies.
                </p>
                <p>
                    The goal is simple: give small businesses a clear online presence first, then
                    add booking, automation, dashboards, or custom software only when those tools
                    actually help the business operate better.
                </p>
            </div>

            <div class="col-lg-6">
                <div class="value-panel">
                    <h3>What we focus on</h3>
                    <ul class="feature-list single-column">
                        <li>Websites that make the offer clear</li>
                        <li>Customer actions like calls, bookings, and quote requests</li>
                        <li>Fast delivery with clean project structure</li>
                        <li>Simple support after launch</li>
                        <li>Business software when a normal website is not enough</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="content-section alt-section">
    <div class="container">
        <div class="text-center mb-5">
            <h2>How KM Digital should be used</h2>
            <p class="lead">
                KM Digital is the main business site. Client websites are separate projects.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="service-card h-100">
                    <div class="card-body">
                        <h3>Sell</h3>
                        <p>Use this site to explain the offer, show previews, and collect leads.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="service-card h-100">
                    <div class="card-body">
                        <h3>Build</h3>
                        <p>Create each customer website in its own project so it can be launched cleanly.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="service-card h-100">
                    <div class="card-body">
                        <h3>Improve</h3>
                        <p>Reuse proven sections, update the portfolio, and turn each launch into a case study.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
