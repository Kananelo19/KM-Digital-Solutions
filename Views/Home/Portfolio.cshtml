@{
    ViewData["Title"] = "Portfolio";
}

<section class="py-5">
    <div class="container py-5">

        <div class="text-center mb-5">
            <span class="text-success fw-bold text-uppercase">
                Our Work
            </span>

            <h1 class="display-4 fw-bold mt-3">
                Software Built Around Real Business Needs
            </h1>

            <p class="lead text-muted mx-auto" style="max-width: 760px;">
                Explore the platforms and systems we are building to help businesses
                manage customers, appointments, operations, and growth.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-lg-6">
                <div class="card service-card h-100">

                    <div class="card-body">

                        <span class="badge bg-dark mb-3">
                            Featured Project
                        </span>

                        <h2 class="fw-bold">
                            A's Barbershop Booking Platform
                        </h2>

                        <p class="text-muted">
                            A complete booking and business management platform designed
                            for barbershops.
                        </p>

                        <ul class="feature-list mt-4">
                            <li>✓ Customer appointment booking</li>
                            <li>✓ Barber dashboards</li>
                            <li>✓ Manager administration</li>
                            <li>✓ Staff and service management</li>
                            <li>✓ Customer appointment history</li>
                            <li>✓ Mobile-responsive experience</li>
                        </ul>

                        <div class="mt-4">
                            <span class="badge bg-light text-dark me-2">
                                React
                            </span>

                            <span class="badge bg-light text-dark me-2">
                                TypeScript
                            </span>

                            <span class="badge bg-light text-dark me-2">
                                Supabase
                            </span>

                            <span class="badge bg-light text-dark">
                                Tailwind
                            </span>
                        </div>

                    </div>

                </div>
            </div>

            <div class="col-lg-6">
                <div class="card service-card h-100">

                    <div class="card-body">

                        <span class="badge bg-dark mb-3">
                            In Development
                        </span>

                        <h2 class="fw-bold">
                            OpportunityOS
                        </h2>

                        <p class="text-muted">
                            An AI-powered business planning system that helps turn ideas
                            into structured opportunities, projects, and actionable tasks.
                        </p>

                        <ul class="feature-list mt-4">
                            <li>✓ AI opportunity analysis</li>
                            <li>✓ Project generation</li>
                            <li>✓ Task generation</li>
                            <li>✓ Opportunity tracking</li>
                            <li>✓ Structured project workflow</li>
                            <li>✓ Local AI integration</li>
                        </ul>

                        <div class="mt-4">
                            <span class="badge bg-light text-dark me-2">
                                ASP.NET Core
                            </span>

                            <span class="badge bg-light text-dark me-2">
                                C#
                            </span>

                            <span class="badge bg-light text-dark me-2">
                                EF Core
                            </span>

                            <span class="badge bg-light text-dark">
                                Ollama
                            </span>
                        </div>

                    </div>

                </div>
            </div>

        </div>

        <div class="text-center mt-5">

            <h2 class="fw-bold">
                Have a project in mind?
            </h2>

            <p class="text-muted">
                Let's discuss what your business needs and what we can build.
            </p>

            <a class="btn btn-success btn-lg px-5"
               asp-controller="Home"
               asp-action="Contact">
                Start a Conversation
            </a>

        </div>

    </div>
</section>