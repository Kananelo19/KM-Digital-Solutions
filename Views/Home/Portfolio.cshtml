@{
    ViewData["Title"] = "Portfolio";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">Our Work</span>
        <h1>Client website previews and business systems.</h1>
        <p>
            KM Digital Solutions turns small business needs into websites, booking flows,
            and practical systems that are clear enough to sell and simple enough to maintain.
        </p>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card service-card h-100">
                    <div class="card-body">
                        <span class="badge bg-dark mb-3">
                            Project 01
                        </span>

                        <h2 class="fw-bold">
                            Gardening Company Website Starter
                        </h2>

                        <p class="text-muted">
                            A client-ready website direction for a local gardening or lawn care
                            company that needs quote requests, service information, and trust.
                        </p>

                        <ul class="feature-list mt-4">
                            <li>Quote request CTA</li>
                            <li>Service cards</li>
                            <li>Before/after gallery section</li>
                            <li>Local service area copy</li>
                            <li>Mobile-responsive layout</li>
                            <li>Launch checklist</li>
                        </ul>

                        <div class="mt-4">
                            <span class="badge bg-light text-dark me-2">HTML</span>
                            <span class="badge bg-light text-dark me-2">CSS</span>
                            <span class="badge bg-light text-dark me-2">Client Project</span>
                            <span class="badge bg-light text-dark">Starter</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card service-card h-100">
                    <div class="card-body">
                        <span class="badge bg-dark mb-3">
                            Concept Preview
                        </span>

                        <h2 class="fw-bold">
                            Barbershop Website + Booking Flow
                        </h2>

                        <p class="text-muted">
                            A professional website concept for barbershops that need online
                            trust, service menus, appointment actions, and a clean mobile experience.
                        </p>

                        <ul class="feature-list mt-4">
                            <li>Service menu</li>
                            <li>Book now CTA</li>
                            <li>Barber profile section</li>
                            <li>Gallery-ready layout</li>
                            <li>Mobile-first design</li>
                            <li>Care plan ready</li>
                        </ul>

                        <div class="mt-4">
                            <span class="badge bg-light text-dark me-2">ASP.NET Core</span>
                            <span class="badge bg-light text-dark me-2">Bootstrap</span>
                            <span class="badge bg-light text-dark me-2">Booking Flow</span>
                            <span class="badge bg-light text-dark">Preview</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <h2 class="fw-bold">
                Have a project in mind?
            </h2>

            <p class="text-muted">
                Start with a preview, then turn the approved direction into a clean client site.
            </p>

            <a class="btn btn-success btn-lg px-5"
               asp-controller="Home"
               asp-action="Contact">
                Start a Conversation
            </a>
        </div>
    </div>
</section>
