@{
    ViewData["Title"] = "KM Digital Solutions";
}

<!-- ================= HERO ================= -->

<section class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">

                <span class="badge mb-4">
                    LITTLE ROCK WEB DESIGN • BOOKING SYSTEMS
                </span>

                <h1 class="display-2 fw-bold">
                    Websites That Help
                    <br />
                    Local Businesses
                    <br />
                    Get More Customers.
                </h1>

                <p class="lead mt-4">
                    KM Digital Solutions builds professional websites and booking systems
                    for service businesses that need more calls, appointments, and online trust.
                </p>

                <div class="mt-5">
                    <a class="btn btn-success btn-lg px-5 me-3">
                        Get Free Website Preview
                    </a>

                    <a class="btn btn-outline-light btn-lg px-5">
                        View Our Work
                    </a>
                </div>

            </div>

            <div class="col-lg-6">
                <div class="hero-dashboard">

                    <div class="dashboard-top">
                        <h3>Website Growth Snapshot</h3>
                        <span class="live-dot"></span>
                    </div>

                    <div class="metric-row">
                        <div class="metric">
                            <h2>+42%</h2>
                            <p>More Bookings</p>
                        </div>

                        <div class="metric">
                            <h2>1,284</h2>
                            <p>Visitors</p>
                        </div>
                    </div>

                    <div class="metric-row">
                        <div class="metric">
                            <h2>$1,500</h2>
                            <p>Starting Price</p>
                        </div>

                        <div class="metric">
                            <h2>99/mo</h2>
                            <p>Website Care</p>
                        </div>
                    </div>

                    <div class="progress mt-4">
                        <div class="progress-bar" style="width:82%"></div>
                    </div>

                    <p class="mt-3 text-secondary">
                        Built to bring more customers online
                    </p>

                </div>
            </div>
        </div>
    </div>
</section>

