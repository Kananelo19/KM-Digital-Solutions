                    View Case Study
                </a>

            </div>
        </div>
    </div>
</section>

<!-- ================= SERVICES ================= -->

<section id="services" class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">
                What We Build
            </h2>

            <p class="lead">
                Websites and systems that help service businesses get customers.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-lg-4">
                <div class="card service-card">
                    <div class="card-body">
                        <h1>01</h1>
                        <h3>Business Websites</h3>
                        <p>
                            Clean, professional websites built to make your business look trusted online.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card service-card">
                    <div class="card-body">
                        <h1>02</h1>
                        <h3>Booking Websites</h3>
                        <p>
                            Websites with appointment booking for barbers, salons, cleaners, and local services.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card service-card">
                    <div class="card-body">
                        <h1>03</h1>
                        <h3>Website Care</h3>
                        <p>
                            Monthly support for updates, fixes, small changes, and keeping the site running.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

