@{
    ViewData["Title"] = "Websites for Local Businesses";
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="badge mb-4">
                    LITTLE ROCK WEB DESIGN • CLIENT-READY WEBSITES
                </span>

                <h1 class="display-2 fw-bold">
                    Build a website that helps your business get calls, bookings, and trust.
                </h1>

                <p class="lead mt-4">
                    KM Digital Solutions builds clean websites, booking flows, and simple
                    business systems for service companies that need customers to understand
                    the offer and take action.
                </p>

                <div class="mt-5">
                    <a class="btn btn-success btn-lg px-5 me-3"
                       asp-controller="Home"
                       asp-action="Contact">
                        Get Free Website Preview
                    </a>

                    <a class="btn btn-outline-light btn-lg px-5"
                       asp-controller="Home"
                       asp-action="Portfolio">
                        View Our Work
                    </a>
                </div>

                <div class="hero-note mt-4">
                    Starting at $1,500. 50% to start. 50% before launch. Optional $99/month website care.
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-dashboard">
                    <div class="dashboard-top">
                        <h3>Client Website Plan</h3>
                        <span class="live-dot"></span>
                    </div>

                    <div class="metric-row">
                        <div class="metric">
                            <h2>01</h2>
                            <p>Clear homepage</p>
                        </div>

                        <div class="metric">
                            <h2>02</h2>
                            <p>Contact flow</p>
                        </div>
                    </div>

                    <div class="metric-row">
                        <div class="metric">
                            <h2>03</h2>
                            <p>Mobile design</p>
                        </div>

                        <div class="metric">
                            <h2>04</h2>
                            <p>Launch support</p>
                        </div>
                    </div>

                    <div class="progress mt-4">
                        <div class="progress-bar" style="width:82%"></div>
                    </div>

                    <p class="mt-3 text-secondary">
                        KM Digital is the studio. Each client website is built as a separate project.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="trust-section">
    <div class="container">
        <p class="trust-title">
            BUILT FOR SMALL SERVICE BUSINESSES
        </p>

        <div class="trust-grid">
            <span>Barbershops</span>
            <span>Landscaping</span>
            <span>Cleaning</span>
            <span>Repair</span>
            <span>Consulting</span>
            <span>Local Services</span>
        </div>
    </div>
</section>

<section class="featured-project">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="project-preview">
                    <span>Project #1</span>
                    <h3>Gardening Company Website</h3>
                    <p>Services • Quote Requests • Gallery • Mobile Launch</p>
                </div>
            </div>

            <div class="col-lg-6">
                <small class="text-uppercase text-success">
                    First Client Direction
                </small>

                <h2 class="display-5 fw-bold mt-3">
                    Gardening Company Website
                </h2>

                <p class="lead mt-4">
                    Our first client project starts with a focused service website: services,
                    local area, photo-ready sections, quote request, and a simple path for customers
                    to call or message.
                </p>

                <ul class="feature-list">
                    <li>Quote Request</li>
                    <li>Service Sections</li>
                    <li>Before/After Gallery</li>
                    <li>Mobile Friendly</li>
                    <li>Local Trust Copy</li>
                    <li>Launch Checklist</li>
                </ul>

                <a class="btn btn-success mt-3"
                   asp-controller="Home"
                   asp-action="Contact">
                    Start Similar Project
                </a>
            </div>
        </div>
    </div>
</section>

<section id="services" class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">
                What We Build
            </h2>

            <p class="lead">
                A focused offer we can deliver fast and improve with every customer.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card service-card">
                    <div class="card-body">
                        <h1>01</h1>
                        <h3>Business Websites</h3>
                        <p>
                            Professional websites with clear services, trust sections, call buttons,
                            quote forms, and mobile-first layouts.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card service-card">
                    <div class="card-body">
                        <h1>02</h1>
                        <h3>Booking Websites</h3>
                        <p>
                            Appointment and request flows for barbers, salons, cleaners, consultants,
                            and other service businesses.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card service-card">
                    <div class="card-body">
                        <h1>03</h1>
                        <h3>Website Care</h3>
                        <p>
                            Monthly support for updates, fixes, edits, launch checks, and keeping
                            the site healthy after launch.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="process" class="process-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">
                How We Deliver
            </h2>

            <p class="lead">
                KM Digital sells and manages the work. Each client website gets its own clean project.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="step-card">
                    <span>01</span>
                    <h3>Preview</h3>
                    <p>We create a private website preview using the business name, offer, and target customers.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="step-card">
                    <span>02</span>
                    <h3>Scope</h3>
                    <p>We confirm pages, content, payment terms, domain needs, and launch expectations.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="step-card">
                    <span>03</span>
                    <h3>Build</h3>
                    <p>The client site is coded separately, tested on mobile, and prepared for launch.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="step-card">
                    <span>04</span>
                    <h3>Launch</h3>
                    <p>We connect the domain, hand over agreed assets, and offer monthly website care.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pricing-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">
                Websites Starting at $1,500
            </h2>

            <p class="lead">
                50% to start. 50% at launch. Optional $99/month website care plan.
            </p>
        </div>

        <div class="text-center">
            <a class="btn btn-success btn-lg px-5"
               asp-controller="Home"
               asp-action="Contact">
                Get Free Website Preview
            </a>
        </div>
    </div>
</section>
