<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KM Digital Solutions</title>
    <meta name="description" content="KM Digital Solutions builds websites, booking systems, and light business software for Little Rock service businesses." />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KM_Digital_Solutions.styles.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark py-3 shadow-sm">
        <div class="container">

            <a class="navbar-brand fw-bold fs-3"
               asp-controller="Home"
               asp-action="Index">

                <span class="text-success">KM</span> Digital

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbar">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="services">
                            Services
                        </a>
                    </li>

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="process">
                            Process
                        </a>
                    </li>

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Portfolio">
                            Portfolio
                        </a>
                    </li>

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="About">
                            About
                        </a>
                    </li>

                    <li class="nav-item mx-2">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Contact">
                            Contact
                        </a>
                    </li>

                    <li class="nav-item ms-lg-3">
                        <a class="btn btn-success px-4 rounded-pill"
                           asp-controller="Home"
                           asp-action="Contact">
                            Start Project
                        </a>
                    </li>

                </ul>

            </div>

        </div>
    </nav>

    @RenderBody()

    <footer class="bg-black text-white py-5 mt-5">

        <div class="container text-center">

            <h3 class="fw-bold">

                <span class="text-success">KM</span> Digital Solutions

            </h3>

            <p class="text-secondary mt-3">

                Websites • Booking Systems • Business Software

            </p>

            <hr />

            <p class="text-secondary">

                © @DateTime.Now.Year KM Digital Solutions

            </p>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
